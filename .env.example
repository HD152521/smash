# ─────────────────────────────────────────────────────────────
# 프론트엔드에 번들되는 값 (VITE_ 접두사 = 브라우저에 그대로 노출됨)
# anon key 는 공개용 키입니다. 보안은 RLS 가 담당합니다.
# ─────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────
# 로컬 스크립트 전용 — VITE_ 접두사를 절대 붙이지 마세요.
# 붙이는 순간 번들에 박혀서 전 세계에 공개됩니다.
# service_role 은 RLS 를 전부 우회합니다.
# ─────────────────────────────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
