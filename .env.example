# ─────────────────────────────────────────────────────────────
# 지금 채워야 하는 값 — 이 둘만 있으면 앱이 돕니다.
#
# VITE_ 접두사가 붙은 값은 빌드 시 브라우저 번들에 문자열로 박힙니다.
# anon key 는 원래 공개용이라 노출돼도 안전합니다.
# 실제 접근 통제는 전부 DB 의 RLS 정책이 합니다.
# ─────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────
# 나중에, 시드 데이터가 필요할 때만.
#
# ⚠ service_role 은 RLS 를 통째로 무시하는 마스터 키입니다.
#   VITE_ 접두사를 붙이는 순간 사이트 방문자 전원에게 배포됩니다.
#   시드 스크립트(scripts/seed.ts)에서만 쓰고, 앱 코드는 건드리지 않습니다.
# ─────────────────────────────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=
