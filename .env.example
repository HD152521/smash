# ─────────────────────────────────────────────────────────────
# 지금 채워야 하는 값 — 이 둘만 있으면 앱이 돕니다.
#
# Supabase 대시보드 → Settings → API Keys 에서 가져옵니다.
# Publishable key 는 sb_publishable_ 로 시작합니다 (예전 이름: anon key).
#
# VITE_ 접두사가 붙은 값은 빌드 시 브라우저 번들에 문자열로 박힙니다.
# Publishable key 는 원래 공개 노출을 전제로 만들어진 키라 괜찮습니다.
# 실제 접근 통제는 전부 DB 의 RLS 정책이 합니다.
# ─────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ─────────────────────────────────────────────────────────────
# 나중에, 시드 데이터가 필요할 때만.
#
# Secret key 는 sb_secret_ 로 시작합니다 (예전 이름: service_role key).
#
# ⚠ RLS 를 통째로 무시하는 마스터 키입니다 (BYPASSRLS).
#   VITE_ 접두사를 붙이는 순간 사이트 방문자 전원에게 배포됩니다.
#   시드 스크립트(scripts/seed.ts)에서만 쓰고, 앱 코드는 건드리지 않습니다.
# ─────────────────────────────────────────────────────────────
SUPABASE_SECRET_KEY=
